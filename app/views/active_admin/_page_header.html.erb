<% has_sidebar = !(skip_sidebar? || sidebar_sections_for_action.blank?) %>
<div data-test-page-header class="px-2.5 md:px-4 py-2 flex items-center justify-between gap-3">
  <div class="min-w-0 flex items-center gap-2">
    <% if has_sidebar %>
      <button type="button" data-aat-sidebar-toggle class="hidden md:inline-flex items-center justify-center w-7 h-7 rounded text-(--aat-text-muted) hover:bg-(--aat-surface-2)" aria-label="<%= t('active_admin.sidebars.filters', default: 'Filters') %>" aria-expanded="true">
        <svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h18l-7 8.5V20l-4-2v-5.5z"/></svg>
      </button>
    <% end %>
    <div class="min-w-0 leading-tight">
      <% breadcrumb_links = build_breadcrumb_links(request.path, class: "no-underline text-(--aat-text-muted) hover:text-(--aat-text)") %>
      <% if breadcrumb_links.present? %>
        <nav aria-label="breadcrumb">
          <ol class="flex flex-wrap items-center gap-x-1 text-xs text-(--aat-text-muted)">
            <% breadcrumb_links.each_with_index do |link, index| %>
              <li class="inline-flex items-center gap-1">
                <% if index > 0 %><span aria-hidden="true">/</span><% end %>
                <%= link %>
              </li>
            <% end %>
          </ol>
        </nav>
      <% end %>
      <h2 class="text-base font-semibold truncate"><%= title %></h2>
    </div>
  </div>
  <% if action_items_for_action.present? %>
    <div data-test-action-items class="aat-action-items flex gap-1.5 flex-wrap justify-end">
      <%= render "active_admin/shared/action_items" %>
    </div>
  <% end %>
</div>
